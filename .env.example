# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Comma-separated chat IDs allowed to use the bot (users, groups or channels).
# Group IDs are negative, e.g. -1001234567890. Use /chatid in any chat to find its ID.
ALLOWED_CHAT_IDS=111111111,-1001234567890

# Optional settings
# How often queued events are flushed to Telegram, in seconds
BATCH_INTERVAL_SECONDS=5
# SQLite file that stores tracked wallets
DB_PATH=data/tracker.db
# Hyperliquid endpoints (mainnet by default; testnet: https://api.hyperliquid-testnet.xyz)
HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws
LOG_LEVEL=INFO
